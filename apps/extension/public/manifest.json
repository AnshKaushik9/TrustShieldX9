{
  "manifest_version": 3,
  "name": "TrustShield AI",
  "version": "1.0.0",
  "description": "Digital Trust Platform",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["activeTab", "storage", "scripting", "alarms", "tabs"]
}
